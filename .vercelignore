# Ignore backend services (not needed for frontend deployment)
backend/
infrastructure/
scripts/
docs/

# Ignore development files
*.log
*.tmp
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore test files
**/__tests__/
**/*.test.*
**/*.spec.*

# Ignore build artifacts from other services
**/dist/
**/build/

# Keep only frontend directory for deployment
!frontend/

# Ignore root package files (use frontend package.json)
package.json
package-lock.json

# Allow frontend node_modules for build
!frontend/node_modules/
