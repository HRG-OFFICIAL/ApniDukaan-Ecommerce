{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for ApniDukaan microservices",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "echo 'No build needed - using JavaScript directly'",
    "start": "node src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "setup": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/helmet": "^4.0.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
