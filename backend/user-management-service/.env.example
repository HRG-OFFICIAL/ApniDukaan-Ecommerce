# ==================== ENVIRONMENT CONFIG ====================
NODE_ENV=development
PORT=3001

# ==================== DATABASE CONFIG ====================
# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://userservice-dev:sRbcE9bUA6G43BZY@cluster0.0ezsixh.mongodb.net/shopsphere_users?retryWrites=true&w=majority&appName=Cluster0
MONGODB_TEST_URI=mongodb+srv://userservice-dev:sRbcE9bUA6G43BZY@cluster0.0ezsixh.mongodb.net/shopsphere_users_test?retryWrites=true&w=majority&appName=Cluster0

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT & SESSION CONFIG ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_EXPIRE=86400000

# ==================== BCRYPT CONFIG ====================
BCRYPT_SALT_ROUNDS=12

# ==================== EMAIL CONFIG ====================
# Email Service Configuration
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@shopsphere.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=ShopSphere <noreply@shopsphere.com>

# Email Service API (Alternative to SMTP)
EMAIL_SERVICE_API_KEY=your-sendgrid-or-mailgun-api-key
EMAIL_SERVICE_PROVIDER=sendgrid

# ==================== SMS & PHONE CONFIG ====================
# Twilio Configuration for SMS MFA
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== OAUTH CONFIG ====================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/users/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/users/auth/facebook/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/users/auth/github/callback

# Twitter OAuth
TWITTER_CONSUMER_KEY=your-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-twitter-consumer-secret
TWITTER_CALLBACK_URL=http://localhost:3001/api/users/auth/twitter/callback

# ==================== FILE UPLOAD CONFIG ====================
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=shopsphere-user-assets

# Cloudinary Configuration (Alternative to S3)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Local File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ==================== SECURITY CONFIG ====================
# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://shopsphere.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_PASSWORD_RESET_MAX=3

# Security Headers
TRUST_PROXY=1

# ==================== LOGGING CONFIG ====================
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
SLOW_REQUEST_THRESHOLD=1000

# ==================== MONITORING CONFIG ====================
# Health Check
HEALTH_CHECK_INTERVAL=30000

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ==================== CACHE CONFIG ====================
CACHE_TTL=3600
USER_CACHE_TTL=1800
SESSION_CACHE_TTL=86400

# ==================== MFA CONFIG ====================
MFA_ISSUER=ShopSphere
MFA_SERVICE_NAME=ShopSphere User Management
TOTP_WINDOW=1
BACKUP_CODES_COUNT=10

# ==================== FEATURE FLAGS ====================
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_AUTH=true
ENABLE_MFA=true
ENABLE_EMAIL_VERIFICATION=true
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_ACCOUNT_LOCKOUT=true

# ==================== ACCOUNT SECURITY CONFIG ====================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# ==================== NOTIFICATION CONFIG ====================
NOTIFICATION_QUEUE_REDIS_URL=redis://localhost:6379/1
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000

# ==================== DEVELOPMENT CONFIG ====================
# Only for development
DEV_SEED_DATABASE=false
DEV_AUTO_VERIFY_EMAILS=true
DEV_MOCK_SMS=true
DEV_BYPASS_MFA=false
DEV_LOG_REQUESTS=true

# ==================== TEST CONFIG ====================
TEST_DATABASE_URL=mongodb+srv://userservice-dev:sRbcE9bUA6G43BZY@cluster0.0ezsixh.mongodb.net/shopsphere_users_test?retryWrites=true&w=majority&appName=Cluster0
TEST_REDIS_URL=redis://localhost:6379/15
