# ========================================
# ShopSphere Order Management Service
# Environment Configuration
# ========================================

# Server Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10000

# Database Configuration
MONGODB_URI=mongodb+srv://userservice-dev:sRbcE9bUA6G43BZY@cluster0.0ezsixh.mongodb.net/shopsphere-orders?retryWrites=true&w=majority&appName=Cluster0
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=45000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=5000

# Security Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
API_KEY=your_api_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://shopsphere.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payment Gateway Configuration - Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Payment Gateway Configuration - PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Shipping Configuration
UPS_ACCESS_KEY=your_ups_access_key_here
UPS_USERNAME=your_ups_username_here
UPS_PASSWORD=your_ups_password_here
UPS_ACCOUNT_NUMBER=your_ups_account_number_here

FEDEX_KEY=your_fedex_key_here
FEDEX_PASSWORD=your_fedex_password_here
FEDEX_ACCOUNT_NUMBER=your_fedex_account_number_here
FEDEX_METER_NUMBER=your_fedex_meter_number_here

USPS_USER_ID=your_usps_user_id_here
USPS_PASSWORD=your_usps_password_here

DHL_ACCOUNT_NUMBER=your_dhl_account_number_here
DHL_USERNAME=your_dhl_username_here
DHL_PASSWORD=your_dhl_password_here

# Email Configuration (for order notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here

# File Storage Configuration
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=shopsphere-orders

# Monitoring Configuration
SENTRY_DSN=https://your_sentry_dsn_here
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# External Service URLs
CATALOG_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3005

# Tax Configuration
TAX_SERVICE_PROVIDER=taxjar
TAXJAR_API_KEY=your_taxjar_api_key_here

# Feature Flags
ENABLE_INVENTORY_TRACKING=true
ENABLE_PAYMENT_WEBHOOKS=true
ENABLE_SHIPPING_LABELS=true
ENABLE_TAX_CALCULATION=true
ENABLE_ORDER_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Cache Configuration
CACHE_DEFAULT_TTL=300
CACHE_ORDER_TTL=1800
CACHE_INVENTORY_TTL=60
CACHE_SHIPPING_TTL=3600

# Queue Configuration
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1
MAX_QUEUE_CONCURRENCY=10

# Business Rules
MIN_ORDER_AMOUNT=0.01
MAX_ORDER_AMOUNT=50000.00
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
ORDER_TIMEOUT_MINUTES=30
INVENTORY_RESERVATION_MINUTES=15

# Development/Testing
MOCK_PAYMENT_GATEWAY=false
MOCK_SHIPPING_CARRIERS=true
MOCK_TAX_SERVICE=true
MOCK_EMAIL_SERVICE=true

# Health Check Configuration
HEALTH_CHECK_DB_TIMEOUT=5000
HEALTH_CHECK_REDIS_TIMEOUT=3000
