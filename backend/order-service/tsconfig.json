{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "../../",
    "paths": {
      "@shopsphere/shared": ["backend/shared/src"]
    }
  },
  "include": [
    "src/**/*",
    "../../backend/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
