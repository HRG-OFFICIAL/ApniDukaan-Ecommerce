# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=apnidukaan-producer
KAFKA_GROUP_ID=apnidukaan-consumer-group

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=apnidukaan

# AWS S3 Configuration (Optional - will use mock if not provided)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=apnidukaan-images
CLOUDFRONT_DOMAIN=your-cloudfront-domain

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Service Ports
CATALOG_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
CART_SERVICE_PORT=4003
ORDER_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development
