# Terraform variables for ApniDukaan E-commerce Platform
# Copy this file to terraform.tfvars and update the values

# AWS Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "apnidukaan"
environment = "dev"

# Domain Configuration
domain_name = "apnidukaan.com"
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/your-certificate-id"

# CORS Configuration
allowed_origins = [
  "http://localhost:3000",
  "http://localhost:5000",
  "https://apnidukaan.com",
  "https://www.apnidukaan.com"
]

# Tags
tags = {
  Project     = "ApniDukaan"
  Environment = "dev"
  ManagedBy   = "Terraform"
  Owner       = "DevOps Team"
}
