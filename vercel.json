{
  "version": 2,
  "buildCommand": "cd frontend && rm -rf .next && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "npm install",
  "devCommand": "cd frontend && npm run dev",
  "framework": "nextjs",
  "functions": {
    "frontend/src/app/api/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_API_URL": "https://apnidukaan-api-gateway.onrender.com",
    "NEXT_PUBLIC_APP_NAME": "ApniDukaan"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://apnidukaan-api-gateway.onrender.com",
      "NEXT_PUBLIC_APP_NAME": "ApniDukaan"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://apnidukaan-api-gateway.onrender.com/api/$1"
    }
  ]
}
